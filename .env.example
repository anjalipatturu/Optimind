# MongoDB Connection
MONGODB_URI=mongodb://127.0.0.1:27017
DATABASE_NAME=prompt_optimizer

# Security & JWT Tokens
JWT_SECRET=change_me_to_a_secure_random_string_32_chars_or_more
JWT_REFRESH_SECRET=change_me_to_another_secure_random_string_32_chars
FRONTEND_URL=http://localhost:5173

# LLM Provider Configuration
LLM_PROVIDER=gemini               # "gemini", "anthropic", or "mock"
ANTHROPIC_API_KEY=
GEMINI_API_KEY=
DEFAULT_MODEL_FAST=gemini-1.5-flash
DEFAULT_MODEL_BALANCED=gemini-1.5-pro
DEFAULT_MODEL_POWERFUL=claude-3-7-sonnet
EMBEDDING_PROVIDER=gemini         # "gemini" or "mock"

# OAuth (Optional)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Web Push Notifications (VAPID)
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:admin@promptoptimizer.ai

# SMTP Email Notifications (Optional)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=

# Upload Constraints
MAX_UPLOAD_MB=10

